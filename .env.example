# Core app
ANTI_FRAUD_ADMIN_TOKEN=change-me
JWT_SECRET=anti-fraud-lab-secret-key-change-in-production-2024
RATE_LIMIT_RPM=0
REQUIRE_AUTH=1
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# Chat flow orchestration: classic | langgraph
CHAT_FLOW_ENGINE=classic

# Local LLM
OLLAMA_BASE_URL=http://localhost:11545
# Docker containers should call the host machine through host.docker.internal.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11545
OLLAMA_MODEL=qwen3-lora

# OpenAI-compatible cloud LLM, e.g. Alibaba Cloud Model Studio (Bailian/DashScope).
# Set LLM_PROVIDER=bailian and enable CHAT_LLM_ENABLED/RAG_LLM_ENABLED when you want
# the app to call Bailian instead of local Ollama.
LLM_PROVIDER=ollama
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
LLM_TIMEOUT=30
LLM_ENABLE_THINKING=0
LLM_MAX_TOKENS=512
# Bailian OpenAI-compatible defaults:
# LLM_PROVIDER=bailian
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# LLM_API_KEY=${DASHSCOPE_API_KEY}
# LLM_MODEL=qwen-plus

# Simple /chat LLM replies without RAG retrieval
CHAT_LLM_ENABLED=0
RAG_RETRIEVAL_ENABLED=1

# RAG retrieval. Local uvicorn uses localhost; Docker Compose injects postgres:5432.
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/anti_fraud_rag
POSTGRES_DB=anti_fraud_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
APP_PORT=8000
RAG_TOP_K=5
RAG_LLM_ENABLED=0
RAG_LLM_TIMEOUT=15
RAG_LLM_MAX_TOKENS=256

# Optional AI risk reviewer. It compares an LLM risk judgment with deterministic
# rules and can only escalate the final risk score when confidence is high.
AI_RISK_ASSESSMENT_ENABLED=0
AI_RISK_TIMEOUT=8
AI_RISK_MAX_TOKENS=240

# BGE-M3 embedding model. Put the downloaded model under ./model/bge-m3.
# Docker mounts this directory at /models/bge-m3.
MODELSCOPE_BGE_M3_MODEL_ID=BAAI/bge-m3
MODELSCOPE_BGE_M3_LOCAL_DIR=./model/bge-m3
BGE_M3_MODEL_NAME=./model/bge-m3
DOCKER_BGE_M3_MODEL_NAME=/models/bge-m3
BGE_M3_USE_FP16=0
