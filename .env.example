# Core app
ANTI_FRAUD_ADMIN_TOKEN=change-me
JWT_SECRET=anti-fraud-lab-secret-key-change-in-production-2024
RATE_LIMIT_RPM=0
CORS_ORIGINS=http://localhost:5173,http://localhost:8000,http://127.0.0.1:5173,http://127.0.0.1:8000

# Chat flow orchestration: classic | langgraph
CHAT_FLOW_ENGINE=classic

# Local LLM
OLLAMA_BASE_URL=http://localhost:11545
# Docker containers should call the host machine through host.docker.internal.
DOCKER_OLLAMA_BASE_URL=http://host.docker.internal:11545
OLLAMA_MODEL=qwen3-lora

# Simple /chat LLM replies without RAG retrieval
CHAT_LLM_ENABLED=1
RAG_RETRIEVAL_ENABLED=0

# RAG retrieval. Fill this and set RAG_RETRIEVAL_ENABLED=1 when pgvector is ready.
PGVECTOR_DSN=postgresql://user:password@localhost:5432/anti_fraud_rag
POSTGRES_DB=anti_fraud_rag
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
APP_PORT=8000
RAG_TOP_K=5
RAG_LLM_ENABLED=0
RAG_LLM_TIMEOUT=15

# BGE-M3 embedding model. Docker RAG tasks download from ModelScope into /models/bge-m3,
# then point FlagEmbedding at that local directory instead of HuggingFace.
MODELSCOPE_BGE_M3_MODEL_ID=BAAI/bge-m3
MODELSCOPE_BGE_M3_LOCAL_DIR=./data/models/bge-m3
BGE_M3_MODEL_NAME=./data/models/bge-m3
BGE_M3_USE_FP16=0
